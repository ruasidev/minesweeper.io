{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../shared"
  ],
  "exclude": [
    "**/*.test.ts",
    "src/testing",
    "../shared/**/*.test.ts",
    "../shared/engine/testing.ts",
    "../shared/training/testing.ts"
  ]
}
