# Copy to .env and fill in. .env is not committed.

# Postgres connection string
DATABASE_URL=postgres://localhost:5432/minesweeper_dev

# Signs session cookies. At least 32 characters; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The URL the browser uses to reach /api/auth.
# In development that is the Vite dev server, which proxies /api to this server.
# Hosted, it is this server's own address (see "Hosting" in the README).
BETTER_AUTH_URL=http://localhost:5173

# Where the frontend is served from. It is the only origin allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:5173

# Port this server listens on
PORT=3000

# Google sign-in (optional: leave empty and the Google button reports that it isn't set up).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with the redirect URI  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
