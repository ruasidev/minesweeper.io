{
  "name": "minesweeper-io-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "set-role": "tsx src/scripts/set-role.ts",
    "demo": "tsx scripts/demo.ts start",
    "demo:clear": "tsx scripts/demo.ts clear"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  }
}
